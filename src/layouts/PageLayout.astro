---
import BaseLayout from "./BaseLayout.astro";
import Nav from "../components/Nav.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
---

<BaseLayout title={title} description={description} image={image}>
  <Nav />
  <main class="pt-20">
    <slot />
  </main>
  <footer
    class="mt-24 border-t px-6 py-8 text-sm border-borde-suave text-texto-secundario dark:bg-consola-fondo/90"
  >
    <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-3">
      <p class="font-titulares text-base font-bold text-texto-principal">🧪JuanFe<span class="text-senal-texto-grande">DS</span></p>
      <nav class="flex flex-wrap gap-x-5 gap-y-2">
        <a href="/projects/">Proyectos</a>
        <a href="/tools/">Tools</a>
        <a href="/blog/">Blog</a>
        <a href="/makeover-monday/">Vizs</a>
        <a href="/about/">Sobre mí</a>
      </nav>
    </div>
  </footer>
</BaseLayout>
