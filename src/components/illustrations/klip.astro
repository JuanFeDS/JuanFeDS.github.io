---
const columns = [
  { x: 22, top: 18, tabs: [{ dot: "#8b5cf6", bar: 40 }, { dot: "#f472b6", bar: 52 }, { dot: "#8b5cf6", bar: 34 }, { dot: "#ffffff", bar: 46 }] },
  { x: 118, top: 32, tabs: [{ dot: "#f472b6", bar: 48 }, { dot: "#ffffff", bar: 36 }, { dot: "#8b5cf6", bar: 54 }] },
  { x: 214, top: 48, tabs: [{ dot: "#ffffff", bar: 44 }, { dot: "#f472b6", bar: 38 }] },
];
const headerBars = [28, 36, 24];
---

<svg class="art" viewBox="0 0 320 180" preserveAspectRatio="xMidYMid slice" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
  {columns.map((column, columnIndex) => (
    <g class="column" style={`--delay: ${columnIndex * 120}ms;`}>
      <rect x={column.x} y={column.top} width="84" height="18" rx="9" fill="#ffffff" />
      <rect x={column.x + 12} y={column.top + 7} width={headerBars[columnIndex]} height="5" rx="2.5" fill="#14b8a6" />
      {column.tabs.map((tab, tabIndex) => (
        <g>
          <rect
            x={column.x}
            y={column.top + 26 + tabIndex * 32}
            width="84"
            height="26"
            rx="9"
            fill="rgba(255,255,255,0.22)"
            stroke="rgba(255,255,255,0.7)"
            stroke-width="1.5"
          />
          <circle cx={column.x + 14} cy={column.top + 39 + tabIndex * 32} r="5" fill={tab.dot} />
          <rect x={column.x + 26} y={column.top + 36.5 + tabIndex * 32} width={tab.bar} height="5" rx="2.5" fill="rgba(255,255,255,0.9)" />
        </g>
      ))}
    </g>
  ))}
</svg>

<style>
  .art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .column {
      animation: rise 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
      animation-delay: var(--delay);
    }
    @keyframes rise {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
  }
</style>
