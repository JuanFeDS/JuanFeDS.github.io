---
const cell = 9;
const halfSprite = [
  "..o.....",
  "..oo....",
  ".ooXoooo",
  "oXXXXXXX",
  "oXXeeXXX",
  "oXXeeXXX",
  "oXXXXXXX",
  "oXXXXooo",
  "oXXXXXXX",
  ".ooXXXXX",
  "..oXoXoX",
  "..oo.oo.",
];
const spriteX = (320 - 16 * cell) / 2;
const spriteY = 22;

const spriteCells = halfSprite.flatMap((row, rowIndex) =>
  [...row].flatMap((char, columnIndex) => {
    if (char === ".") return [];
    const fill = char === "X" ? "#ffffff" : char === "e" ? "#2a1a5e" : "rgba(60, 20, 120, 0.6)";
    return [columnIndex, 15 - columnIndex].map((mirrored) => ({
      x: spriteX + mirrored * cell,
      y: spriteY + rowIndex * cell,
      fill,
    }));
  }),
);

const mountainHeights = [2, 2, 3, 3, 4, 5, 4, 4, 3, 2, 2, 3, 4, 4, 5, 6, 5, 4, 3, 3, 2, 2, 3, 4, 5, 4, 3, 3, 2, 2, 3, 3, 4, 3, 2, 2];
const sunCells = [
  [1, 0], [2, 0], [0, 1], [1, 1], [2, 1], [3, 1], [0, 2], [1, 2], [2, 2], [3, 2], [1, 3], [2, 3],
];
const stars = [[250, 24], [286, 48], [60, 100], [292, 96], [30, 70]];
---

<svg class="art" viewBox="0 0 320 180" preserveAspectRatio="xMidYMid slice" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
  {mountainHeights.map((height, index) => (
    <rect x={index * cell} y={180 - height * cell} width={cell} height={height * cell} fill="rgba(255,255,255,0.2)" />
  ))}

  {sunCells.map(([column, row]) => (
    <rect x={18 + column * 7} y={14 + row * 7} width="7" height="7" fill="rgba(255,255,255,0.85)" />
  ))}

  {stars.map(([x, y]) => (
    <rect x={x} y={y} width="4" height="4" fill="rgba(255,255,255,0.7)" />
  ))}

  <g class="sprite">
    {spriteCells.map((spriteCell) => (
      <rect x={spriteCell.x} y={spriteCell.y} width={cell} height={cell} fill={spriteCell.fill} />
    ))}
  </g>
</svg>

<style>
  .art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .sprite {
      animation: bob 0.9s steps(2) infinite alternate;
    }
    @keyframes bob {
      from { transform: translateY(0); }
      to { transform: translateY(-5px); }
    }
  }
</style>
