---
interface Props {
  eyebrow: string;
  title: string;
  width?: "3xl" | "5xl";
}

const { eyebrow, title, width = "5xl" } = Astro.props;

const widthClass = { "3xl": "max-w-3xl", "5xl": "max-w-5xl" }[width];
---

<section class="section-hero">
  <div class={`mx-auto ${widthClass} px-6 pt-8 pb-5`}>
    <header class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="mb-2 text-sm font-medium text-marca-texto">{eyebrow}</p>
        <h1 class="section-title font-bold font-titulares text-texto-principal">{title}</h1>
        <p class="mt-2 max-w-2xl text-base text-texto-secundario"><slot /></p>
      </div>
      <slot name="aside" />
    </header>
  </div>
</section>

<style>
  .section-hero {
    margin-top: -5rem;
    padding-top: 5rem;
    margin-bottom: 0.5rem;
    background: var(--marca-fondo-aurora-portada);
  }
  .section-title {
    font-size: clamp(2rem, 4.5vw, 3rem);
    line-height: 1;
    letter-spacing: -0.03em;
  }
</style>
