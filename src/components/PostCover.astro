---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { postColors, tagLabel } from "../lib/blog-tags";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, tags, image } = post.data;

const illustrations = import.meta.glob<{ default: any }>("./post-illustrations/*.astro", { eager: true });
const Illustration = illustrations[`./post-illustrations/${post.id}.astro`]?.default;

const [colorA, colorB] = postColors(tags);
const deep = (color: string) => `color-mix(in srgb, ${color} 72%, #000)`;
const gradient = `linear-gradient(135deg, ${deep(colorA)} 0%, ${deep(colorB)} 100%)`;
const headline = title.split(":")[0];
---

<div class="post-cover" style={`background: ${gradient};`}>
  {image ? (
    <Image src={image} alt="" widths={[360, 640, 960]} sizes="(max-width: 768px) 100vw, 480px" class="post-cover-img" />
  ) : Illustration ? (
    <Illustration />
  ) : (
    <>
      <span class="post-cover-tag">{tags[0] ? tagLabel(tags[0]) : "Blog"}</span>
      <span class="post-cover-headline font-display">{headline}</span>
    </>
  )}
</div>

<style>
  .post-cover {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    aspect-ratio: 16 / 9;
    container-type: inline-size;
    padding: 0.9rem 1rem;
    overflow: hidden;
    border-radius: 1.25rem;
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .post-cover::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 90% at 0% 0%, rgba(255, 255, 255, 0.22), transparent 60%);
    pointer-events: none;
  }

  .post-cover-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .post-cover-tag {
    position: relative;
    z-index: 1;
    align-self: flex-start;
    padding: 0.15rem 0.6rem;
    border-radius: 9999px;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.95);
    background: rgba(0, 0, 0, 0.28);
  }
  .post-cover-headline {
    position: relative;
    z-index: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: clamp(1.15rem, 8.7cqw, 2.4rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: #ffffff;
  }

  @media (prefers-reduced-motion: reduce) {
    .post-cover { transition: none; }
  }
</style>
