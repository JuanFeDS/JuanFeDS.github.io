---
const projects = [34, 78, 122].map((y, index) => ({ y, delay: index * 120, bar: [38, 30, 44][index] }));
const arrows = [51, 95, 139].map((y) => `M122 ${y} C134 ${y} 130 95 144 95`);
const steps = [14, 26, 38, 50, 62].map((height, index) => ({
  x: 152 + index * 15,
  y: 126 - height,
  height,
  focal: index === 2,
  delay: index * 90,
}));
const dimensions = [44, 30, 18, 36].map((height, index) => ({ x: 236 + index * 11, y: 126 - height, height }));
const levelDots = [0, 1, 2, 3, 4].map((index) => ({ x: 164 + index * 11, filled: index < 3 }));
---

<svg class="art" viewBox="0 0 320 180" preserveAspectRatio="xMidYMid slice" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
  {projects.map((project) => (
    <g class="project" style={`--delay: ${project.delay}ms;`}>
      <rect x="50" y={project.y} width="72" height="34" rx="9" fill="rgba(255,255,255,0.2)" stroke="rgba(255,255,255,0.7)" stroke-width="1.5" />
      <circle cx="63" cy={project.y + 11} r="3.5" fill="rgba(255,255,255,0.95)" />
      <rect x="73" y={project.y + 8.5} width={project.bar} height="5" rx="2.5" fill="rgba(255,255,255,0.92)" />
      <rect x="59" y={project.y + 19} width="52" height="4" rx="2" fill="rgba(255,255,255,0.5)" />
      <rect x="59" y={project.y + 26} width="34" height="4" rx="2" fill="rgba(255,255,255,0.5)" />
    </g>
  ))}

  <g fill="none" stroke="rgba(255,255,255,0.85)" stroke-width="2" stroke-linecap="round">
    {arrows.map((path) => <path d={path} />)}
  </g>
  <path d="M146 95 l-7 -5 v10 z" fill="#ffffff" />

  <line x1="150" y1="130" x2="228" y2="130" stroke="rgba(255,255,255,0.45)" stroke-width="1.5" stroke-linecap="round" />
  {steps.map((step) => (
    <rect
      class="step"
      style={`--delay: ${step.delay}ms;`}
      x={step.x}
      y={step.y}
      width="11"
      height={step.height}
      rx="4"
      fill={step.focal ? "#ffffff" : "rgba(255,255,255,0.22)"}
      stroke={step.focal ? "none" : "rgba(255,255,255,0.7)"}
      stroke-width="1.5"
    />
  ))}

  <rect x="150" y="138" width="78" height="20" rx="10" fill="#ffffff" />
  {levelDots.map((dot) => (
    <circle cx={dot.x} cy="148" r="3.2" fill={dot.filled ? "#8b5cf6" : "rgba(139,92,246,0.28)"} />
  ))}

  {dimensions.map((bar) => (
    <rect x={bar.x} y={bar.y} width="7" height={bar.height} rx="3.5" fill="rgba(255,255,255,0.92)" />
  ))}
  <line x1="232" y1="130" x2="276" y2="130" stroke="rgba(255,255,255,0.45)" stroke-width="1.5" stroke-linecap="round" />
  <g fill="rgba(255,255,255,0.7)">
    {dimensions.map((bar) => <circle cx={bar.x + 3.5} cy="142" r="2.5" />)}
  </g>
</svg>

<style>
  .art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .project {
      animation: slide 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
      animation-delay: var(--delay);
    }
    @keyframes slide {
      from { opacity: 0; transform: translateX(-10px); }
      to { opacity: 1; transform: translateX(0); }
    }
    .step {
      transform-box: fill-box;
      transform-origin: bottom;
      animation: grow 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
      animation-delay: var(--delay);
    }
    @keyframes grow {
      from { transform: scaleY(0); }
      to { transform: scaleY(1); }
    }
  }
</style>
