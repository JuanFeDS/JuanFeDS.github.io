---
const codeLines = [
  { x: 72, y: 66, width: 80 },
  { x: 84, y: 82, width: 110 },
  { x: 84, y: 98, width: 64 },
  { x: 72, y: 130, width: 52 },
];
---

<svg class="art" viewBox="0 0 320 180" preserveAspectRatio="xMidYMid slice" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
  <rect x="56" y="34" width="208" height="112" rx="12" fill="rgba(255,255,255,0.18)" stroke="rgba(255,255,255,0.7)" stroke-width="1.5" />

  <g fill="rgba(255,255,255,0.85)">
    <circle cx="72" cy="48" r="3" />
    <circle cx="84" cy="48" r="3" />
    <circle cx="96" cy="48" r="3" />
  </g>

  <g fill="rgba(255,255,255,0.9)">
    {codeLines.map((line) => (
      <rect x={line.x} y={line.y} width={line.width} height="6" rx="3" />
    ))}
  </g>

  <rect class="ghost" x="84" y="113" width="122" height="10" rx="5" fill="none" stroke="rgba(255,255,255,0.8)" stroke-width="1.5" stroke-dasharray="4 4" />

  <g class="spark">
    <rect x="214" y="105" width="32" height="32" rx="10" fill="#ffffff" />
    <path transform="translate(220 111) scale(0.85)" d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z" fill="#f472b6" />
    <path transform="translate(220 111) scale(0.85)" d="M19 15l.7 1.8 1.8.7-1.8.7L19 20l-.7-1.8-1.8-.7 1.8-.7z" fill="#8b5cf6" />
  </g>
</svg>

<style>
  .art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ghost {
      animation: march 1.4s linear infinite;
    }
    @keyframes march {
      to { stroke-dashoffset: -16; }
    }
    .spark {
      transform-box: fill-box;
      transform-origin: center;
      animation: pulse 1.2s ease-in-out infinite alternate;
    }
    @keyframes pulse {
      from { transform: scale(0.94); }
      to { transform: scale(1.06); }
    }
  }
</style>
