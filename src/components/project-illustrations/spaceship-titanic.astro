---
const points = Array.from({ length: 14 }, (_, index) => {
  const trend = 132 - 72 * (1 - Math.exp(-index / 5));
  const wobble = Math.sin(index * 1.9) * 9 * (1 - index / 14);
  return { x: 30 + index * 20, y: Number((trend + wobble).toFixed(1)) };
});
const trendPath = points.map((point, index) => `${index === 0 ? "M" : "L"}${point.x} ${point.y}`).join(" ");
const best = points[points.length - 1];
const gridLines = [60, 90, 120, 150];
---

<svg class="art" viewBox="0 0 320 180" preserveAspectRatio="xMidYMid slice" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
  <g stroke="rgba(255,255,255,0.18)" stroke-width="1">
    {gridLines.map((y) => <line x1="20" y1={y} x2="300" y2={y} />)}
  </g>

  <line x1="148" y1="44" x2="148" y2="168" stroke="rgba(255,255,255,0.55)" stroke-width="1.5" stroke-dasharray="4 5" />

  <path class="trend" d={trendPath} fill="none" stroke="rgba(255,255,255,0.85)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />

  <g fill="rgba(255,255,255,0.3)" stroke="rgba(255,255,255,0.75)" stroke-width="1.5">
    {points.slice(0, -1).map((point) => <circle cx={point.x} cy={point.y} r="5" />)}
  </g>

  <circle cx={best.x} cy={best.y} r="11" fill="#ffffff" />
  <circle cx={best.x} cy={best.y} r="4.5" fill="#8b5cf6" />

  <rect x="112" y="20" width="72" height="22" rx="11" fill="#ffffff" />
  <circle cx="126" cy="31" r="4" fill="#f472b6" />
  <rect x="138" y="28" width="34" height="6" rx="3" fill="#8b5cf6" />
</svg>

<style>
  .art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .trend {
      stroke-dasharray: 420;
      animation: draw 1.1s ease-out both;
    }
    @keyframes draw {
      from { stroke-dashoffset: 420; }
      to { stroke-dashoffset: 0; }
    }
  }
</style>
