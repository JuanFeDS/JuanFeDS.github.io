---
import { getCollection } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";

export async function getStaticPaths() {
  const lecturas = (await getCollection("lecturas")).filter((lectura) => !lectura.data.draft);
  return lecturas.map((lectura) => ({ params: { slug: lectura.id }, props: { lectura } }));
}

const { lectura } = Astro.props;
const { title, description, source_title, source_url, pdf } = lectura.data;
const informe = `/lecturas/${lectura.id}/informe.html`;
---

<PageLayout title={title} description={description}>
  <div class="barra mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 px-6 py-4">
    <a href="/lecturas/" class="pill">← Lecturas</a>
    <div class="flex flex-wrap items-center gap-2">
      <a href={source_url} target="_blank" rel="noopener" class="pill" title={source_title}>Fuente original ↗</a>
      {pdf && <a href={`/lecturas/${lectura.id}/${lectura.id}.pdf`} class="pill">Descargar PDF</a>}
      <a href={informe} class="pill">Abrir solo</a>
    </div>
  </div>

  <iframe id="informe" src={informe} title={title} class="informe-frame" scrolling="no"></iframe>
</PageLayout>

<style>
  .pill {
    padding: 0.3rem 0.9rem;
    border-radius: 9999px;
    font-size: 0.78rem;
    font-weight: 500;
    border: 1px solid var(--marca-borde-suave);
    color: var(--marca-texto-secundario);
    text-decoration: none;
    transition: all 0.15s;
  }
  .pill:hover {
    border-color: var(--marca-marca-texto);
    color: var(--marca-marca-texto);
  }
  .pill:focus-visible {
    outline: 2px solid var(--marca-foco-anillo);
    outline-offset: 3px;
  }
  .informe-frame {
    display: block;
    width: 100%;
    min-height: 100vh;
    border: 0;
  }
</style>

<script>
  const frame = document.getElementById("informe") as HTMLIFrameElement;
  const raiz = document.documentElement;

  function sincronizarTema(doc: Document) {
    const oscuroSitio = raiz.classList.contains("dark");
    const oscuroInforme = doc.documentElement.classList.contains("dark");
    if (oscuroSitio !== oscuroInforme) doc.getElementById("modo")?.click();
  }

  function ajustarAltura(doc: Document) {
    frame.style.height = `${doc.documentElement.scrollHeight}px`;
  }

  let iniciado: Document | null = null;

  function iniciar() {
    const doc = frame.contentDocument;
    if (!doc || doc.readyState !== "complete" || iniciado === doc) return;
    iniciado = doc;

    const estilo = doc.createElement("style");
    estilo.textContent = "#modo { display: none !important; }";
    doc.head.appendChild(estilo);

    sincronizarTema(doc);
    ajustarAltura(doc);

    new ResizeObserver(() => ajustarAltura(doc)).observe(doc.body);
    new MutationObserver(() => sincronizarTema(doc)).observe(raiz, {
      attributes: true,
      attributeFilter: ["class"],
    });
  }

  frame.addEventListener("load", iniciar);
  iniciar();
</script>
