---
import { getCollection } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";
import SectionHero from "../../components/SectionHero.astro";
import PostRow from "../../components/PostRow.astro";
import { tagLabel } from "../../lib/blog-tags";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<PageLayout
  title="Blog"
  description="Artículos sobre ciencia de datos, ingeniería, herramientas y la industria tech."
>
  <SectionHero eyebrow="Escritura" title="Blog" accent="purple" width="3xl">
    Opiniones, reflexiones y divulgación sobre datos, tecnología y lo que me llama la atención.
  </SectionHero>

  <div class="mx-auto max-w-3xl px-6 pb-16">

    {allTags.length > 0 && (
      <div class="tag-filters" id="tag-filters">
        <button class="tag-btn active" data-tag="all">Todos</button>
        {allTags.map((tag) => (
          <button class="tag-btn" data-tag={tag}>{tagLabel(tag)}</button>
        ))}
      </div>
    )}

    {posts.length === 0 ? (
      <p class="text-text-muted">Próximamente...</p>
    ) : (
      <ol class="flex flex-col" id="posts-list">
        {posts.map((post, index) => (
          <li class={index === 0 ? "post-item is-first" : "post-item"} data-tags={post.data.tags.join(",")}>
            <PostRow post={post} />
          </li>
        ))}
      </ol>
    )}

  </div>
</PageLayout>

<style>
  .post-item {
    margin-top: 2.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-border);
  }
  .post-item.is-first {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }
  .tag-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .tag-btn {
    padding: 0.3rem 0.9rem;
    border-radius: 9999px;
    font-size: 0.78rem;
    font-weight: 500;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all 0.15s;
  }
  .tag-btn:hover {
    border-color: var(--color-aurora-purple);
    color: var(--color-aurora-purple);
  }
  .tag-btn.active {
    background: color-mix(in srgb, var(--color-aurora-purple) 12%, transparent);
    border-color: var(--color-aurora-purple);
    color: var(--color-aurora-purple);
  }
</style>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>(".tag-btn");
  const items = document.querySelectorAll<HTMLLIElement>("#posts-list li");

  btns.forEach((btn) => {
    btn.addEventListener("click", () => {
      btns.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");

      const tag = btn.dataset.tag!;
      items.forEach((item) => {
        const tags = item.dataset.tags?.split(",") ?? [];
        item.style.display = tag === "all" || tags.includes(tag) ? "" : "none";
        item.classList.remove("is-first");
      });
      const firstVisible = [...items].find((item) => item.style.display !== "none");
      firstVisible?.classList.add("is-first");
    });
  });
</script>
